package-as: WASDBars

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

required-dependencies:
  - libeditmode
  - libeditmodeoverride

ignore:
  - docs
  - tests
  - scripts
  - openspec
  - Makefile
  - CLAUDE.md
  - INSTALL.md
  - README.md
  - CONTRIBUTING.md
  - skills-lock.json
